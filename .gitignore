# Generated IDE project files (recreate with GenerateProjectFiles)
# ---------------------------------------------------------------------------
# Visual Studio
*.sln
*.suo
*.opensdf
*.sdf
*.VC.db
*.VC.opendb
.vs/

# Xcode
*.xcworkspace/
*.xcodeproj/
xcuserdata/
DerivedData/

# Rider / VS Code / CLion
.idea/
.vscode/
*.code-workspace
.vsconfig
cmake-build-*/

# ---------------------------------------------------------------------------
# Compiled files
# ---------------------------------------------------------------------------
*.obj
*.o
*.pch
*.pdb
*.dll
*.dylib
*.so
*.lib
*.a
*.exe
*.app/
*.dSYM/
*.ipa
*.apk

# ---------------------------------------------------------------------------
# SQLite temporary files (keep Data/map_extended.db itself)
# ---------------------------------------------------------------------------
*.db-journal
*.db-wal
*.db-shm

